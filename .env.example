# cal.com API key (create one at https://app.cal.com/settings/developer/api-keys)
CAL_API_KEY=cal_live_xxxxxxxxxxxxxxxx

# Your cal.com username (used to look up your event types).
# Optional when CAL_API_KEY is set — resolved from /me at startup if omitted.
CAL_USERNAME=your-username

# LLM provider: "anthropic" (Claude, needs ANTHROPIC_API_KEY) or "mock" (no key needed)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxx

# Claude model: claude-haiku-4-5 is fast + cheap for a demo; unset it for the
# default (claude-opus-4-8, most capable). Thinking auto-adapts per model.
LLM_MODEL=claude-haiku-4-5

# Default timezone used when talking about times with the assistant.
# Optional — resolved from your cal.com profile at startup if omitted.
TIMEZONE=UTC

# Override for self-hosted cal.com instances (defaults to the hosted API)
# CAL_API_BASE_URL=https://api.cal.com/v2
