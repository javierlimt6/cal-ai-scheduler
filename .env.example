# cal.com API key (create one at https://app.cal.com/settings/developer/api-keys)
CAL_API_KEY=cal_live_xxxxxxxxxxxxxxxx

# Your cal.com username (used to look up your event types)
CAL_USERNAME=your-username

# LLM provider: "mock" (no API key needed) — real providers plug in later
LLM_PROVIDER=mock

# Default timezone used when talking about times with the assistant
TIMEZONE=UTC
